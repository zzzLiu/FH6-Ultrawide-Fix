                        </local:FZMaterial>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding (local:BindingProxy.B), RelativeSource={RelativeSource Self}}"
                         Value="{x:Static local:LockState.Locked}">
