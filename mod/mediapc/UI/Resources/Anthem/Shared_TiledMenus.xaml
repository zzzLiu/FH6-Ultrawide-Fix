                            <Setter Property="ImageSourceNoPreload"
                                Value="/ForzaUI;component/Textures/Anthem/Icons/TiledMenus/FloatingIcons/Locked.png" TargetName="FloatingIconContent" />
                            <Setter Property="Color"
                                Value="{StaticResource A_Color_Tile_FloatingIcon_Foreground_Locked}"
                                TargetName="FloatingIconContent" />
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

