<Page DataContext="{Binding RelativeSource={RelativeSource Self}}"
      FlowDirection="LeftToRight"
      Style="{StaticResource A_Style_Page_Generic}"
      mc:Ignorable="d"
      x:Class="ForzaUI.A_DestinationMenu"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:System="clr-namespace:System;assembly=mscorlib"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:ForzaUI;assembly="
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      local:AttachedTileMenu.TileMenuNavigationManager="{local:TileMenuNavigationManager}">

    <Page.Resources>
        <ResourceDictionary>
            <Double x:Key="A_Double_Badge_Width">95</Double>
        </ResourceDictionary>

        <Style x:Key="A_Style_Grid_Tiled_TextMenu_With_Title" TargetType="Grid"
            BasedOn="{StaticResource A_Style_Grid_Tiled_TextMenu}">
            <Setter Property="VerticalAlignment" Value="Stretch"/>
            <Setter Property="Margin" Value="72,220,0,161"/>
        </Style>

        <Style x:Key="A_Style_FZTextBlock_TabTitle" TargetType="FZTextBlock"
            BasedOn="{StaticResource A_Style_FZTextBlock_HorizonC}">
            <Setter Property="CapHeight" Value="58"/>
            <Setter Property="Color" Value="{StaticResource H_Color_Primary_White}"/>
            <Setter Property="Margin" Value="0,0,-200,0"/>
            <Setter Property="Stretch" Value="None"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="LineAdjust" Value="-0.60"/>
            <Setter Property="Effect" Value="{StaticResource A_DropShadowEffect_DefaultHud}" />
            <Setter Property="TileMenuNavigationManager.GridWidth"
                    Value="{Binding (Grid.ColumnSpan), RelativeSource={RelativeSource Self}, FallbackValue=1}" />
            <Setter Property="TileMenuNavigationManager.GridHeight"
                    Value="{Binding (Grid.RowSpan), RelativeSource={RelativeSource Self}, FallbackValue=1}" />
        </Style>

        <Style x:Key="A_Style_FZButton_Inactive_Tiled_Header" TargetType="FZButton">
            <Setter Property="TileMenuNavigationManager.TileState"
                    Value="{x:Static local:TileState.EnabledNonInteractive}"/>
            <Setter Property="TileMenuNavigationManager.GridX"
                    Value="{Binding (Grid.Column), RelativeSource={RelativeSource Self}, FallbackValue=0}" />
            <Setter Property="TileMenuNavigationManager.GridY"
                    Value="{Binding (Grid.Row), RelativeSource={RelativeSource Self}, FallbackValue=0}" />
            <Setter Property="TileMenuNavigationManager.GridWidth"
                    Value="{Binding (Grid.ColumnSpan), RelativeSource={RelativeSource Self}, FallbackValue=1}" />
            <Setter Property="TileMenuNavigationManager.GridHeight"
                    Value="{Binding (Grid.RowSpan), RelativeSource={RelativeSource Self}, FallbackValue=1}" />
            <Setter Property="MinValue.A"
                    Value="{StaticResource A_Int32_EnableMotionBlur}"/>
            <Setter Property="MinValue.B"
                    Value="{StaticResource A_Int32_DisableMotionBlur}"/>
            <Setter Property="IsEnabled" Value="False"/>
            <Setter Property="IsSfxEnabled" Value="False"/>
            <Setter Property="IsHitTestVisible" Value="False"/>
            <Setter Property="ClickMode" Value="Hover"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="RenderTransformOrigin"
                    Value="0.5,0.5" />
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <TransformGroup>
                        <ScaleTransform/>
                        <SkewTransform/>
                        <RotateTransform/>
                        <TranslateTransform/>
                    </TransformGroup>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate
                        TargetType="{Type local:FZButton}">
                        <Decorator Style="{StaticResource A_Style_OptInMotionBlur}">
                            <ContentPresenter />
                        </Decorator>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Page.Resources>

    <local:UIPageTransitionManager.TransitionManager>
        <local:UIPageTransitionManager Preset="{StaticResource A_UIPageTransitionManagerPreset_TiledRootMenu}" />
    </local:UIPageTransitionManager.TransitionManager>

    <Grid KeyboardNavigation.DirectionalNavigation="Contained"
          x:Name="PART_LayoutRoot"
          local:ScreenReader.Line="{local:Loc ScreenTitles.IDS_FestivalSite}"
          local:ScreenReader.Event="OnLoad"
          local:ScreenReader.LineType="ScreenTitle">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="IdleStateGroup">
                <VisualStateGroup.Transitions>
                    <VisualTransition GeneratedDuration="0:0:0.2"/>
                </VisualStateGroup.Transitions>
                <VisualState x:Name="PART_IdleState">
                    <Storyboard>
                        <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="(UIElement.Opacity)" Storyboard.TargetName="PART_LayoutRoot">
                            <EasingDoubleKeyFrame KeyTime="0" Value="0"/>
                        </DoubleAnimationUsingKeyFrames>
                    </Storyboard>
                </VisualState>
                <VisualState x:Name="PART_ActiveState">
                    <Storyboard>
                        <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="(UIElement.Opacity)" Storyboard.TargetName="PART_LayoutRoot">
                            <EasingDoubleKeyFrame KeyTime="0" Value="1"/>
                        </DoubleAnimationUsingKeyFrames>
                    </Storyboard>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
        <!-- Pattern_Background.png is placed for a 16:9 frame (element 897x865, left margin -1340).
             On 3440x1440 the 16:9 frame is inset, so the lattice no longer meets the left edge.
             Scale it uniformly by 1.45 about its right edge and shift left so the same part of the
             texture sits on the screen edge. Menu text stays in the 16:9 layout below. -->
        <Grid local:UIPageTransitionManager.TransitionTags="PatternedBackground"
              Style="{StaticResource A_Style_FrameworkElement_FadeOnlyTransition_0}">
            <Grid.Resources>
                <Style x:Key="A_Style_FZMaterial_PatternedBackground" TargetType="FZMaterial">
                    <Setter Property="Margin" Value="-560,-194,0,0"/>
                    <Setter Property="Width" Value="1298"/>
                    <Setter Property="Height" Value="1252"/>
                    <Setter Property="HorizontalAlignment" Value="Left"/>
                    <Setter Property="VerticalAlignment" Value="Top"/>
                    <Setter Property="Stretch" Value="Uniform"/>
                    <Setter Property="ImageSourceNoPreload" Value="/ForzaUI;component/Textures/Data_Bound/DestinationMenu/Pattern_Background.png"/>
                </Style>
                <Style x:Key="A_Style_FZMaterial_GradientStrip" TargetType="FZMaterial">
                    <Setter Property="ImageSourceNoPreload" Value="/ForzaUI;component/Textures/Data_Bound/DestinationMenu/gradient_strip.png"/>
                    <Setter Property="MultiDataConversion.TargetType" Value="Double"/>
                    <Setter Property="MultiDataConversion.Converter" Value="{MathOperationConverter Operation=Divide}"/>
                    <Setter Property="MultiDataConversion.Value" Value="{Binding ActualWidth, ElementName=PatternScaledRoot}"/>
                    <Setter Property="MultiDataConversion.Parameter" Value="{Binding ActualWidth, RelativeSource={RelativeSource Self}}"/>
                    <Setter Property="ImageTransform">
                        <Setter.Value>
                            <TransformGroup>
                                <ScaleTransform CenterX="0.5"
                                        CenterY="0.5"
                                        ScaleX="{Binding (MultiDataConversion.Output), RelativeSource={RelativeSource FindAncestor, AncestorType=FZMaterial}, FallbackValue=1.0}"
                                        ScaleY="1.0" />
                                <ScaleTransform CenterX="0.5"
                                        CenterY="0.5"
                                        ScaleX="{Binding ScaleValue, Source={StaticResource PART_UIResolutionScaler}}"
                                        ScaleY="1.0" />
                            </TransformGroup>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Grid.Resources>
            <FZMaterial Style="{StaticResource A_Style_FZMaterial_GradientStrip}"/>
            <Decorator x:Name="PatternScaledRoot" Style="{StaticResource A_Style_FrameworkElement_LayoutRoot}">
                <FZMaterial Style="{StaticResource A_Style_FZMaterial_PatternedBackground}"/>
            </Decorator>
        </Grid>
        <!-- Bars -->
        <local:PlayerBarControl Style="{StaticResource A_Style_PlayerBarControl}"
                        x:Name="TopBar" />
        <ContentControl Style="{StaticResource A_Style_ButtonBar}"
                        x:Name="BottomBar">
            <ContentControl Style="{StaticResource A_Style_ContentControl_DefaultButtonBar}"
                            local:ControllerButtonPanel.ADescription="{local:Loc HelpButtons.IDS_Select}"
                            local:ControllerButtonPanel.BDescription="{local:Loc HelpButtons.IDS_Back}"
                            x:Name="PART_DefaultHelpPanel" />
        </ContentControl>
        <Grid Style="{StaticResource A_Style_FrameworkElement_LayoutRoot}">
            <Decorator Margin="72,155"
                    Style="{StaticResource A_Style_FrameworkElement_TiledMenuTransition_0}">
                    <StackPanel>
                        <!-- if you are changing anything related to this tab bar, make sure to run the test UILongRunning\DestinationMenuTests\Verify_TabEnumAndXAMLGroupsMatch -->
                        <FZTabButtonsSelector
                            x:Name="TabSelector"
                            HorizontalAlignment="Left"
                            HorizontalContentAlignment="Left"
                            MaxWidth="1440"
                            Margin="0,0,0,0"
                            VerticalAlignment="Top"
                            Style="{StaticResource H_Style_TabBar}"
                            SelectedItem="{Binding (AttachedTileMenu.TileMenuNavigationManager).SelectedMenu, RelativeSource={RelativeSource AncestorType=Page}}">
                            <FZButton
                                    Content="{local:Loc DestinationMenu.IDS_Campaign}"
                                    Style="{StaticResource H_Style_TabButton}"
                                    Tag="{Binding NotificationBadgeCampaignTab}"
                                    x:Name="PART_GROUP_Campaign"
                                    TileMenuNavigationManager.InitialSelection="true"/>
                            <FZButton
                                    Content="{local:Loc DestinationMenu.IDS_BuySell}"
                                    Style="{StaticResource H_Style_TabButton}"
                                    x:Name="PART_GROUP_Autoshow" />
                            <FZButton
                                    Content="{local:Loc DestinationMenu.IDS_Garage}"
                                    Style="{StaticResource H_Style_TabButton}"
                                    x:Name="PART_GROUP_Garage"
                                    Tag="{Binding NotificationBadgeGarage}" />
                            <FZButton
                                    Content="{local:Loc DestinationMenu.IDS_MyHouse}"
                                    Style="{StaticResource H_Style_TabButton}"
                                    MaxWidth="400"
                                    x:Name="PART_GROUP_MyHouse"
                                    TileMenuNavigationManager.TileState="{Binding IsInHouse, Converter={StaticResource A_Converter_BooleanToTileState}}"
                                    Visibility="{Binding (TileMenuNavigationManager.TileState), RelativeSource={RelativeSource Self}, Converter={StaticResource H_Converter_TileStateToVisibility}}"/>
                            <FZButton
                                    Content="{local:Loc DestinationMenu.IDS_MyCharacter}"
                                    Style="{StaticResource H_Style_TabButton}"
                                    x:Name="PART_GROUP_MyCharacter"
                                    Tag="{Binding NotificationBadgeCharacterTab}" />
                    </FZTabButtonsSelector>
                </StackPanel>
            </Decorator>
            <Grid x:Name="PART_MenuContent">
                <Grid Style="{StaticResource A_Style_Grid_Tiled_TextMenu_With_Title}"
                      x:Name="PART_SCOPE_Campaign">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    
                    <FZButton Style="{StaticResource A_Style_FZButton_Inactive_Tiled_Header}"
                              Grid.Row="0">
                        <FZTextBlock Style="{StaticResource A_Style_FZTextBlock_TabTitle}"
                                     Text="{Loc DestinationMenu.IDS_Campaign}"/>
                    </FZButton>
                    <local:FZButton Style="{StaticResource A_Style_FZButton_Tiled_TextMenu}"
                                    x:Name="PART_Button_GoToDrive"
                                    Grid.Row="1"
                                    Command="{Binding GoToDriveCommand, RelativeSource={RelativeSource AncestorType=Page}}">
                        <local:FZButton.DataContext>
                            <local:TileMenuDataItem Heading="{Loc DestinationMenu.IDS_ExploreJapan}" />
                        </local:FZButton.DataContext>
                    </local:FZButton>
                    <local:FZButton Style="{StaticResource A_Style_FZButton_Tiled_TextMenu}"
                                    x:Name="PART_Button_CampaignProgress"
                                    Grid.Row="2"
                                    local:BindingProxy.A="{Binding NotificationBadgeCampaign, RelativeSource={RelativeSource AncestorType=Page, Mode=FindAncestor}}"
                                    Command="{Binding GoToCampaignProgressCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                    Tag="Numeric">
                        <local:FZButton.DataContext>
                            <local:TileMenuDataItem Heading="{Loc PauseMenu.IDS_TileTitle_CampaignProgress}"
                                                    Description="{Loc PauseMenu.IDS_TileText_CampaignProgress}" />
                        </local:FZButton.DataContext>
                    </local:FZButton>

                    <local:FZButton Style="{StaticResource A_Style_FZButton_Tiled_TextMenu}"
                                    x:Name="PART_Button_FestivalPass"
                                    Grid.Row="3"
                                    Command="{Binding GoToReturnToGameCommand, RelativeSource={RelativeSource AncestorType=Page}}">
                        <local:FZButton.DataContext>
                            <local:TileMenuDataItem Heading="{local:Loc PauseMenu.IDS_TileTitle_FestivalPass}"
                                                    Description="{local:Loc PauseMenu.IDS_TileText_FestivalPass}" />
                        </local:FZButton.DataContext>
                    </local:FZButton>
                    <local:FZButton Style="{StaticResource A_Style_FZButton_Tiled_TextMenu}"
                                    x:Name="PART_Button_Settings"
                                    Grid.Row="4"
                                    Command="{Binding GoToSettingsCommand, RelativeSource={RelativeSource AncestorType=Page}}">
                        <local:FZButton.DataContext>
                            <local:TileMenuDataItem Heading="{local:Loc PauseMenu.IDS_TileTitle_Settings}"
                                                    Description="{local:Loc PauseMenu.IDS_TileTitle_Settings}" />
                        </local:FZButton.DataContext>
                    </local:FZButton>
                </Grid>

                <Grid Style="{StaticResource A_Style_Grid_Tiled_TextMenu_With_Title}"
                      x:Name="PART_SCOPE_Autoshow">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <FZButton Style="{StaticResource A_Style_FZButton_Inactive_Tiled_Header}"
                              Grid.Row="0">
                        <FZTextBlock Style="{StaticResource A_Style_FZTextBlock_TabTitle}"
                                    Text="{Loc DestinationMenu.IDS_BuySell}"/>
                    </FZButton>
                    <local:FZButton Style="{StaticResource A_Style_FZButton_Tiled_TextMenu}"
                                    x:Name="PART_Button_Autoshow"
                                    TileMenuNavigationManager.InitialSelection="True"
                                    Grid.Row="1"
                                    Command="{Binding GoToAutoshowCommand, RelativeSource={RelativeSource AncestorType=Page}}">
                        <local:FZButton.DataContext>
                            <local:TileMenuDataItem Heading="{local:Loc DestinationMenu.IDS_Autoshow}"
                                                    Description="{local:Loc DestinationMenu.IDS_Autoshow_Sub}" />
                        </local:FZButton.DataContext>
                    </local:FZButton>
                    <local:FZButton Style="{StaticResource A_Style_FZButton_Tiled_TextMenu}"
                                    x:Name="PART_Button_AuctionHouse"
                                    Grid.Row="2"
                                    Command="{Binding GoToAuctionHouseMenuCommand, RelativeSource={RelativeSource AncestorType=Page}}">
                        <local:FZButton.DataContext>
                            <local:TileMenuDataItem Heading="{local:Loc DestinationMenu.IDS_AuctionHouse}"
                                                    Description="{local:Loc DestinationMenu.IDS_AuctionHouse_Sub}"/>
                        </local:FZButton.DataContext>
                    </local:FZButton>
                    <local:FZButton Style="{StaticResource A_Style_FZButton_Tiled_TextMenu}"
                                    x:Name="PART_Button_CarPass"
                                    Grid.Row="3"
                                    Command="{Binding GoToCarPassCommand, RelativeSource={RelativeSource AncestorType=Page}}">
                        <local:FZButton.DataContext>
                            <local:TileMenuDataItem Heading="{local:Loc DestinationMenu.IDS_CarPass}"
                                                    Description="{local:Loc DestinationMenu.IDS_CarPass_Sub}"/>
                        </local:FZButton.DataContext>
                    </local:FZButton>
                    <local:FZButton Style="{StaticResource A_Style_FZButton_Tiled_TextMenu}"
                                    x:Name="PART_Button_CarPacks"
                                    Grid.Row="4"
                                    local:BindingProxy.A="{Binding CarPacksNotification, RelativeSource={RelativeSource AncestorType=Page}, FallbackValue={x:Null}}"
                                    Command="{Binding GoToCarPacksCommand, RelativeSource={RelativeSource AncestorType=Page}}">
                        <local:FZButton.DataContext>
                            <local:TileMenuDataItem Heading="{local:Loc DestinationMenu.IDS_CarPacks}"
                                                    Description="{local:Loc DestinationMenu.IDS_CarPacks_Sub}" />
                        </local:FZButton.DataContext>
                    </local:FZButton>
                    <local:FZButton Style="{StaticResource A_Style_FZButton_Tiled_TextMenu}"
                                    x:Name="PART_Button_VoucherCars"
                                    Grid.Row="5"
                                    Command="{Binding GoToVoucherCarsCommand, RelativeSource={RelativeSource AncestorType=Page}}">
                        <local:FZButton.DataContext>
                            <local:TileMenuDataItem Heading="{local:Loc DestinationMenu.IDS_VoucherCars}" />
                        </local:FZButton.DataContext>
                    </local:FZButton>
                </Grid>

                <Grid Style="{StaticResource A_Style_Grid_Tiled_TextMenu_With_Title}"
                      x:Name="PART_SCOPE_Garage">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <FZButton Style="{StaticResource A_Style_FZButton_Inactive_Tiled_Header}"
                              Grid.Row="0">
                        <FZTextBlock Style="{StaticResource A_Style_FZTextBlock_TabTitle}"
                                    Text="{Loc DestinationMenu.IDS_Garage}"/>
                    </FZButton>
                    <local:FZButton Style="{StaticResource A_Style_FZButton_Tiled_TextMenu}"
                                    x:Name="PART_Button_ChangeCar"
                                    TileMenuNavigationManager.InitialSelection="True"
                                    Grid.Row="1"
                                    Command="{Binding GoToChangeCarCommand, RelativeSource={RelativeSource AncestorType=Page}}">
                        <local:FZButton.DataContext>
                            <local:TileMenuDataItem Heading="{local:Loc DestinationMenu.IDS_MyCars}"
                                                    Description="{local:Loc DestinationMenu.IDS_MyCars_Sub}" />
                        </local:FZButton.DataContext>
                    </local:FZButton>
                    <local:FZButton  Style="{StaticResource A_Style_FZButton_Tiled_TextMenu}"
                                     x:Name="PART_Button_Upgrade"
                                     Grid.Row="2"
                                     Command="{Binding GoToUpgradeCarCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                     local:BindingProxy.A="{Binding UpgradeBreadcrumbs, RelativeSource={RelativeSource FindAncestor, AncestorType=Page}}">
                        <local:FZButton.DataContext>
                            <local:TileMenuDataItem Heading="{local:Loc DestinationMenu.IDS_Upgrades}"
                                                Description="{local:Loc DestinationMenu.IDS_Upgrades_Sub}"/>
                        </local:FZButton.DataContext>
                    </local:FZButton>
                    <local:FZButton Style="{StaticResource A_Style_FZButton_Tiled_TextMenu}"
                                    x:Name="PART_Button_Paint"
                                    Grid.Row="3"
                                    Command="{Binding GoToPaintCommand, RelativeSource={RelativeSource AncestorType=Page}}">
                        <local:FZButton.DataContext>
                            <local:TileMenuDataItem Heading="{local:Loc DestinationMenu.IDS_Designs}"
                                                    Description="{local:Loc DestinationMenu.IDS_Designs_Sub}" />
                        </local:FZButton.DataContext>
                    </local:FZButton>

                    <local:FZButton x:Name="PART_Button_CarHorns"
                                    Grid.Row="4"
                                    Style="{StaticResource A_Style_FZButton_Tiled_TextMenu}"
                                    Command="{Binding GoToCarHornsCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                    BindingProxy.A="{Binding Path=NotificationBadgeCarHorns, RelativeSource={RelativeSource AncestorType=Page, Mode=FindAncestor}}"
                                    Tag="Numeric">
                        <local:FZButton.DataContext>
                            <local:TileMenuDataItem Heading="{local:Loc DestinationMenu.IDS_CarHorns}"/>
                        </local:FZButton.DataContext>
                    </local:FZButton>
                    <local:FZButton x:Name="PART_Button_LicensePlateCustomisation"
                                    Grid.Row="5"
                                    Style="{StaticResource A_Style_FZButton_Tiled_TextMenu}"
                                    Command="{Binding GoToLicensePlateCustomizationCommand, RelativeSource={RelativeSource AncestorType=Page}}">
                        <local:FZButton.DataContext>
                            <local:TileMenuDataItem Heading="{local:Loc DestinationMenu.IDS_LicensePlateCustomisation}" />
                        </local:FZButton.DataContext>
                    </local:FZButton>
                    <local:FZButton Style="{StaticResource A_Style_FZButton_Tiled_TextMenu}"
                                    local:BindingProxy.A="{Binding NotificationBadgeBarnFinds, RelativeSource={RelativeSource AncestorType=Page, Mode=FindAncestor}}"
                                    x:Name="PART_Button_BarnFinds"
                                    Grid.Row="6"
                                    Command="{Binding GoToBarnFindsCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                    Tag="Numeric">
                        <local:FZButton.DataContext>
                            <local:TileMenuDataItem Heading="{local:Loc DestinationMenu.IDS_BarnFinds}"/>
                        </local:FZButton.DataContext>
                    </local:FZButton>
                    <local:FZButton x:Name="PART_Button_TreasureCars"
                                    Grid.Row="7"
                                    Style="{StaticResource A_Style_FZButton_Tiled_TextMenu}"
                                    local:BindingProxy.A="{Binding NotificationBadgeTreasureCars, RelativeSource={RelativeSource AncestorType=Page, Mode=FindAncestor}}"
                                    Command="{Binding GoToTreasureCarsCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                    Tag="Numeric">
                        <local:FZButton.DataContext>
                            <local:TileMenuDataItem Heading="{local:Loc PauseMenu.IDS_TileTitle_TreasureCars}"/>
                        </local:FZButton.DataContext>
                    </local:FZButton>
                </Grid>

                <Grid Style="{StaticResource A_Style_Grid_Tiled_TextMenu_With_Title}"
                      x:Name="PART_SCOPE_MyCharacter">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <FZButton Style="{StaticResource A_Style_FZButton_Inactive_Tiled_Header}"
                              Grid.Row="0">
                        <FZTextBlock Style="{StaticResource A_Style_FZTextBlock_TabTitle}"
                                    Text="{Loc DestinationMenu.IDS_MyCharacter}"/>
                    </FZButton>
                    <local:FZButton Style="{StaticResource A_Style_FZButton_Tiled_TextMenu}"
                                    x:Name="PART_Button_CharacterCustomisation"
                                    TileMenuNavigationManager.InitialSelection="True"
                                    Grid.Row="1"
                                    Command="{Binding GoToCharacterCustomizationCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                    BindingProxy.A="{Binding Path=NotificationBadgeCharacterCustomiser, RelativeSource={RelativeSource AncestorType=Page, Mode=FindAncestor}}"
                                    Tag="Numeric">
                        <local:FZButton.DataContext>
                            <local:TileMenuDataItem Heading="{local:Loc DestinationMenu.IDS_CharacterCustomisation}"
                                                    Description="{local:Loc DestinationMenu.IDS_CharacterCustomisation_Sub}" />
                        </local:FZButton.DataContext>
                    </local:FZButton>
                    <local:FZButton Style="{StaticResource A_Style_FZButton_Tiled_TextMenu}"
                                    x:Name="PART_Button_NameSelect"
                                    Grid.Row="2"
                                    Command="{Binding GoToNameSelectCommand, RelativeSource={RelativeSource AncestorType=Page}}">
                        <local:FZButton.DataContext>
                            <local:TileMenuDataItem Heading="{local:Loc DestinationMenu.IDS_NameSelect}"
                                                    Description="{local:Loc DestinationMenu.IDS_NameSelect_Sub}" />
                        </local:FZButton.DataContext>
                    </local:FZButton>
                    <local:FZButton Style="{StaticResource A_Style_FZButton_Tiled_TextMenu}"
                                    x:Name="PART_Button_QuickChat"
                                    Grid.Row="3"
                                    Command="{Binding GoToQuickChatCommand, RelativeSource={RelativeSource AncestorType=Page}}">
                        <local:FZButton.DataContext>
                            <local:TileMenuDataItem Heading="{local:Loc DestinationMenu.IDS_QuickChat}"
                                                    Description="{local:Loc DestinationMenu.IDS_QuickChat_Sub}" />
                        </local:FZButton.DataContext>
                    </local:FZButton>
                    <local:FZButton Style="{StaticResource A_Style_FZButton_Tiled_TextMenu}"
                                    x:Name="PART_Button_Stats"
                                    Grid.Row="4"
                                    Command="{Binding StatsCommand, RelativeSource={RelativeSource AncestorType=Page}}">
                        <local:FZButton.DataContext>
                            <local:TileMenuDataItem Heading="{Loc PauseMenu.IDS_TileTitle_Stats}"
                                                    Description="{Loc PauseMenu.IDS_TileText_Stats}" />
                        </local:FZButton.DataContext>
                    </local:FZButton>
                </Grid>

                <Grid Style="{StaticResource A_Style_Grid_Tiled_TextMenu_With_Title}" 
                      x:Name="PART_SCOPE_MyHouse">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <FZButton Style="{StaticResource A_Style_FZButton_Inactive_Tiled_Header}"
                        Grid.Row="0">
                        <FZTextBlock Style="{StaticResource A_Style_FZTextBlock_TabTitle}"
                                    Text="{Loc DestinationMenu.IDS_MyHouse}"/>
                    </FZButton>
                    <local:FZButton Style="{StaticResource A_Style_FZButton_Tiled_TextMenu}" 
                                    x:Name="PART_Button_CustomiseGarage"
                                    Grid.Row="1"
                                    Command="{Binding GoToCustomiseGarageCommand, RelativeSource={RelativeSource AncestorType=Page}}">
                        <local:FZButton.DataContext>
                            <local:TileMenuDataItem Heading="{Loc DestinationMenu.IDS_CustomiseGarage}" />
                        </local:FZButton.DataContext>
                    </local:FZButton>
                    <local:FZButton Style="{StaticResource A_Style_FZButton_Tiled_TextMenu}"
                                    x:Name="PART_Button_ViewCustomisedGarage"
                                    Grid.Row="2"
                                    Command="{Binding GoToViewCustomisedGarageCommand, RelativeSource={RelativeSource AncestorType=Page}}">
                        <local:FZButton.DataContext>
                            <local:TileMenuDataItem Heading="{local:Loc DestinationMenu.IDS_ViewCustomisedGarage}" />
                        </local:FZButton.DataContext>
                    </local:FZButton>
                    <local:FZButton Style="{StaticResource A_Style_FZButton_Tiled_TextMenu}"
                                    x:Name="PART_Button_BrowseConfigure"
                                    Grid.Row="3"
                                    Command="{Binding GoToBrowseConfigureGarageCommand, RelativeSource={RelativeSource AncestorType=Page}}">
                        <local:FZButton.DataContext>
                            <local:TileMenuDataItem Heading="{local:Loc DestinationMenu.IDS_BrowseConfigure}" />
                        </local:FZButton.DataContext>
                    </local:FZButton>
                    <local:FZButton Style="{StaticResource A_Style_FZButton_Tiled_TextMenu}"
                                    x:Name="PART_Button_DisplayCars"
                                    Grid.Row="4"
                                    Command="{Binding GoToDisplayCarsCommand, RelativeSource={RelativeSource AncestorType=Page}}">
                        <local:FZButton.DataContext>
                            <local:TileMenuDataItem Heading="{local:Loc DestinationMenu.IDS_DisplayCars}" />
                        </local:FZButton.DataContext>
                    </local:FZButton>
                    <FZButton x:Name="PART_VisitorPermission"
                              Style="{StaticResource A_Style_FZButton_Tiled_TextMenu}"
                              Grid.Row="5"
                              Command="{Binding VisitorPermissionCommand, RelativeSource={RelativeSource AncestorType=Page}}" 
                              BindingProxy.A="{Binding IsGarageOpen, RelativeSource={RelativeSource AncestorType=Page}, Converter={StaticResource A_Converter_VisitorPermission_To_String}}">
                        <FZButton.Resources>
                            <Style x:Key="A_Style_FZMaterial_Tiled_Notification_Background" TargetType="{x:Type FZMaterial}">
                                <Setter Property="Color" Value="{Binding IsGarageOpen, RelativeSource={RelativeSource AncestorType=Page}, Converter={StaticResource A_Converter_VisitorPermission_To_Background_Color}}"/>
                            </Style>

                            <Style x:Key="A_Style_FZMaterial_Tiled_Notification_Text" TargetType="{x:Type FZTextBlock}">
                                <Setter Property="Color" Value="{Binding IsGarageOpen, RelativeSource={RelativeSource AncestorType=Page}, Converter={StaticResource A_Converter_VisitorPermission_To_Text_Color}}"/>
                                <Setter Property="Text" Value="{Binding Description, Converter={StaticResource A_StringToUpper}}"/>
                            </Style>
                        </FZButton.Resources>
                        <FZButton.DataContext>
                            <TileMenuDataItem
                                Heading="{Loc GarageLayout.IDS_GarageMenu_TileTitle_VisitorPermission}"
                                Description="{Binding IsGarageOpen, RelativeSource={RelativeSource AncestorType=Page}, Converter={StaticResource A_Converter_VisitorPermission_To_String}}" />
                        </FZButton.DataContext>
                    </FZButton>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Page>
