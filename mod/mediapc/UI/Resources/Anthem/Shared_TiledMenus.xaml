<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" 
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:ForzaUI;assembly="
    xmlns:System="clr-namespace:System;assembly=mscorlib">
    
    <!-- Tile Sizes -->
    <System:Double x:Key="A_Double_ZOffset_Selected">-10</System:Double>

    <System:Double x:Key="A_Double_Badge_Width">64</System:Double>

    <System:Double x:Key="A_Double_Size_TileUnitSizeWithGap">140</System:Double>
    <System:Double x:Key="A_Double_Size_TileNegativeGap">-5</System:Double>

    <System:Double x:Key="A_Double_Size_SunriseTileUnitSizeWithGap">24</System:Double>
    <System:Double x:Key="A_Double_Size_SunriseTileNegativeGap">-6</System:Double>

    <System:Double x:Key="A_Double_Size_Tile_TitlePanel">90</System:Double>

    <!-- Adding an extra .5 to the stroke thickness as we were getting 'cracks' between the highlight and tile contents -->
    <Thickness x:Key="A_Thickness_TileEdgeBorderOnly">3,3,3,3</Thickness>
    <Thickness x:Key="A_Thickness_TileEdgeBorderOnly_WithOffset">3.5,3.5,3.5,3.5</Thickness>
    <Thickness x:Key="A_Thickness_TileBorderedBackground">3,3,3,90</Thickness>
    <Thickness x:Key="A_Thickness_TileBorderedBackground_WithOffset">3.5,3.5,3.5,90.5</Thickness>

    <local:FZMaterialPresetRoundtangleStroke x:Key="A_FZMaterialPresetRoundtangleStroke_TileBackground_BorderedImage"
        BasedOn="{StaticResource A_FZMaterialPresetRoundtangle_FlatPanel_OuterAll}"
        Thickness="{StaticResource A_Thickness_TileBorderedBackground_WithOffset}"/>

    <local:FZMaterialPresetRoundtangleStroke x:Key="A_FZMaterialPresetRoundtangleStroke_TileBackground_EdgeBorderOnly"
        BasedOn="{StaticResource A_FZMaterialPresetRoundtangle_FlatPanel_OuterAll}"
        Thickness="{StaticResource A_Thickness_TileEdgeBorderOnly_WithOffset}"/>


    <GridLength x:Key="A_GridLength_TileMenu_Height">768</GridLength>

    <!-- Converters -->
    <local:LinearTransformConverter x:Key="A_LinearTransformConverter_TilePositionTransform" Scale="{StaticResource A_Double_Size_TileUnitSizeWithGap}"/>
    <local:LinearTransformConverter x:Key="A_LinearTransformConverter_TileSizeTransform"
                                    Scale="{StaticResource A_Double_Size_TileUnitSizeWithGap}"
                                    Add="{StaticResource A_Double_Size_TileNegativeGap}" />

    <local:LinearTransformConverter x:Key="A_LinearTransformConverter_SunriseTilePositionTransform"
                                    Scale="{StaticResource A_Double_Size_SunriseTileUnitSizeWithGap}"/>
    <local:LinearTransformConverter x:Key="A_LinearTransformConverter_SunriseTileSizeTransform"
                                    Scale="{StaticResource A_Double_Size_SunriseTileUnitSizeWithGap}"
                                    Add="{StaticResource A_Double_Size_SunriseTileNegativeGap}" />

    <!-- CircleGeometry -->

    <!--Converters-->

    <!-- Padding -->
    <Thickness x:Key="A_Thickness_TilePadding_IconTile">15</Thickness>
    <Thickness x:Key="A_Thickness_TilePadding">20</Thickness>
    <Style x:Key="A_Style_MotionBlur" TargetType="{x:Type FrameworkElement}">
        <Setter Property="Effect" Value="{StaticResource A_MotionBlurEffect}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding (local:BindingProxy.C), RelativeSource={RelativeSource TemplatedParent}}" Value="DisableMotionBlur">
                <Setter Property="Effect" Value="{x:Null}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="A_Style_Grid_MotionBlur" TargetType="{x:Type Grid}" BasedOn="{StaticResource A_Style_MotionBlur}"/>
    <Style x:Key="A_Style_FZMaterial_MotionBlurExpander" TargetType="{x:Type local:FZMaterial}">
        <Setter Property="Margin" Value="-10" />
        <Setter Property="Opacity" Value="0" />
        <Setter Property="IsHitTestVisible" Value="False" />
    </Style>    

    <!--FZTextblock Styles-->
  
    <local:MappingConverter x:Key="A_Converter_TextColorSchemeToTileTextColor"
        Default="{StaticResource A_Color_Tile_Text}">
    </local:MappingConverter>

    <local:MappingConverter x:Key="A_Converter_TextColorSchemeToTileTextColor_Alternate"
        Default="{StaticResource A_Color_Tile_Text_Alternate}">
    </local:MappingConverter>

    <Style x:Key="A_Style_Run_TileText_THIN"
        TargetType="{x:Type local:FZRun}">
        <Setter Property="FontFamily" Value="Horizon_B"/>
    </Style>

    <MappingConverter x:Key="A_MappingConverter_TitleText" >
        <MappingConverterEntry Key="{NoCase THIN}" Value="{StaticResource A_Style_Run_TileText_THIN}" />
    </MappingConverter>

    <Style x:Key="A_Style_FZTextBlock_TileText_Base" TargetType="{x:Type local:FZTextBlock}" BasedOn="{StaticResource A_Style_FZTextBlock_HorizonA}">
        <Setter Property="Color" Value="{Binding (local:TileMenuNavigationManager.TextColorScheme), RelativeSource={RelativeSource FindAncestor, AncestorType=Button}, Converter={StaticResource A_Converter_TextColorSchemeToTileTextColor}, FallbackValue={StaticResource A_Color_Tile_Text}}"/>
        <Setter Property="TextWrapping" Value="NoWrap"/>
        <Setter Property="Stretch" Value="Uniform" />
        <Setter Property="StretchDirection" Value="DownOnly" />
        <Setter Property="TextAlignment" Value="Left"/>
        <Setter Property="LineAdjust" Value="-0.3"/>
        <Setter Property="FontSize" Value="24" />
        <Setter Property="Text" Value="{Binding DataContext.Description, RelativeSource={RelativeSource FindAncestor, AncestorType=Button}}" />
        <Setter Property="MarkupConverter" Value="{StaticResource A_MappingConverter_TitleText}"/>
        <Setter Property="Margin" Value="0" />
        <Style.Triggers>
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding Text, Converter={StaticResource A_StringVisConverter}, RelativeSource={RelativeSource Self}, FallbackValue={x:Static Visibility.Collapsed}}" Value="{x:Static Visibility.Collapsed}"/>
                    <Condition Binding="{Binding (Text), Converter={StaticResource A_StringVisConverter}, RelativeSource={RelativeSource Self}, FallbackValue={x:Static Visibility.Collapsed}}" Value="{x:Static Visibility.Collapsed}"/>
                </MultiDataTrigger.Conditions>
                <Setter Property="Visibility" Value="{x:Static Visibility.Collapsed}"/>
            </MultiDataTrigger> 
        </Style.Triggers>
    </Style>

    <Style x:Key="A_Style_FZTextBlock_TileText" TargetType="{x:Type local:FZTextBlock}" BasedOn="{StaticResource A_Style_FZTextBlock_TileText_Base}">
        <Style.Resources>
            <Color x:Key="A_Color_Tile_Text_Alternate">#FFFFFFFF</Color>
        </Style.Resources>
        <Style.Triggers>
            <DataTrigger Binding="{Binding UseAlternateColors}"
                         Value="True">
                <Setter Property="Color"
                        Value="{DynamicResource A_Color_Tile_Text_Alternate}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding (local:TileMenuNavigationManager.LockState), RelativeSource={RelativeSource FindAncestor, AncestorType=Button}}"
                         Value="{x:Static local:LockState.Locked}">
                <Setter Property="Color"
                        Value="{StaticResource A_Color_Tile_Text_Locked_Alternate}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="A_Style_FZTextBlock_TileText_IconTile" TargetType="{x:Type local:FZTextBlock}" BasedOn="{StaticResource A_Style_FZTextBlock_TileText_Base}">
        <Style.Resources>
            <Color x:Key="A_Color_Tile_Text_Alternate">#FFFFFFFF</Color>
        </Style.Resources>
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="TextWrapping" Value="WrapWithOverflow" />
        <Setter Property="MaxHeight" Value="60" />
        <Setter Property="Margin" Value="75,0,0,0" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding UseAlternateColors}"
                         Value="True">
                <Setter Property="Color"
                        Value="{DynamicResource A_Color_Tile_Text_Alternate}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding (local:TileMenuNavigationManager.LockState), RelativeSource={RelativeSource FindAncestor, AncestorType=Button}}"
                         Value="{x:Static local:LockState.Locked}">
                <Setter Property="Color"
                        Value="{StaticResource A_Color_Tile_Text_Icon_Locked}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="A_Style_FZTextBlock_TileText_ImageTile" TargetType="{x:Type local:FZTextBlock}" BasedOn="{StaticResource A_Style_FZTextBlock_TileText}">
        <Setter Property="Margin" Value="0,8,0,0"/>
        <Style.Resources>
            <Color x:Key="A_Color_Tile_Text_Alternate">#FF00B592</Color>
        </Style.Resources>
        <Style.Triggers>
            <DataTrigger Binding="{Binding (local:TileMenuNavigationManager.LockState), RelativeSource={RelativeSource FindAncestor, AncestorType=Button}}"
                         Value="{x:Static local:LockState.Locked}">
                <Setter Property="Text" Value="{local:Loc TiledMenus.IDS_TileText_NotAvailable}"/>
            </DataTrigger>

            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding (local:TileMenuNavigationManager.LockState), RelativeSource={RelativeSource FindAncestor, AncestorType=Button}}"
                         Value="{x:Static local:LockState.Locked}"/>
                    <Condition Binding="{Binding LockDescription, Converter={StaticResource A_StringVisConverter}, FallbackValue=Hidden}"
                         Value="{x:Static Visibility.Visible}"/>
                </MultiDataTrigger.Conditions>
                <Setter Property="Text" Value="{Binding LockDescription}"/>
            </MultiDataTrigger>
            
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding (local:TileMenuNavigationManager.LockState), RelativeSource={RelativeSource FindAncestor, AncestorType=Button}}"
                               Value="{x:Static local:LockState.Locked}" />
                    <Condition Binding="{Binding UseAlternateColors}"
                               Value="False" />
                </MultiDataTrigger.Conditions>
                <Setter Property="Color"
                        Value="{StaticResource A_Color_Tile_Text_Locked}" />
            </MultiDataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="A_Style_FZTextBlock_TileText_ImageTile_Alternate" TargetType="{x:Type local:FZTextBlock}" BasedOn="{StaticResource A_Style_FZTextBlock_TileText_ImageTile}">
        <Setter Property="Color" Value="{Binding (local:TileMenuNavigationManager.TextColorScheme), RelativeSource={RelativeSource FindAncestor, AncestorType=Button}, Converter={StaticResource A_Converter_TextColorSchemeToTileTextColor_Alternate}, FallbackValue={StaticResource A_Color_Tile_Text_Alternate}}"/>
    </Style>

    <local:MappingConverter x:Key="A_Converter_TextColorSchemeToTileTitleColor"
        Default="{StaticResource A_Color_Tile_Title}">
    </local:MappingConverter>

    <local:MappingConverter x:Key="A_Converter_TextColorSchemeToTileTitleColor_Alternate"
        Default="{StaticResource A_Color_Tile_Title_Alternate}">
    </local:MappingConverter>

    <Style x:Key="A_Style_FZTextBlock_TileTitle" TargetType="{x:Type local:FZTextBlock}" BasedOn="{StaticResource A_Style_FZTextBlock_Title}">
        <Setter Property="Color" Value="{Binding (local:TileMenuNavigationManager.TextColorScheme), RelativeSource={RelativeSource FindAncestor, AncestorType=Button}, Converter={StaticResource A_Converter_TextColorSchemeToTileTitleColor}, FallbackValue={StaticResource A_Color_Tile_Title}}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="Stretch" Value="Uniform" />
        <Setter Property="StretchDirection" Value="DownOnly" />
        <Setter Property="VerticalAlignment" Value="Top" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="TextAlignment" Value="Center"/>
        <Setter Property="FontSize"
                Value="34" />
        <Setter Property="Text" Value="{Binding DataContext.Heading, RelativeSource={RelativeSource AncestorType=Button}, Converter={StaticResource A_StringToUpper}}" />
        <Setter Property="Margin"
                Value="0" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding DataContext.UseAlternateColors, RelativeSource={RelativeSource AncestorType=Button}}" Value="True">
                <Setter Property="Color"
                        Value="{Binding (local:TileMenuNavigationManager.TextColorScheme), RelativeSource={RelativeSource FindAncestor, AncestorType=Button}, Converter={StaticResource A_Converter_TextColorSchemeToTileTitleColor_Alternate}, FallbackValue={StaticResource A_Color_Tile_Title_Alternate}}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding (local:TileMenuNavigationManager.LockState), RelativeSource={RelativeSource FindAncestor, AncestorType=Button}}"
                         Value="{x:Static local:LockState.Locked}">
                <Setter Property="Color"
                        Value="{StaticResource A_Color_Tile_Title_Locked}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="A_Style_FZTextBlock_TileTitle_Alternate"
        TargetType="{x:Type local:FZTextBlock}"
        BasedOn="{StaticResource A_Style_FZTextBlock_TileTitle}">
        <Setter Property="Color" Value="{Binding (local:TileMenuNavigationManager.TextColorScheme), RelativeSource={RelativeSource FindAncestor, AncestorType=Button}, Converter={StaticResource A_Converter_TextColorSchemeToTileTitleColor_Alternate}, FallbackValue={StaticResource A_Color_Tile_Title_Alternate}}"/>
    </Style>

    <local:LinearTransformConverter x:Key="A_TransitionIndexToZIndexConverter"
        Add="-100"
        Scale="-1"/>

    <local:MappingConverter x:Key="A_Converter_TileStateToVisibility"
        Default="{x:Static Visibility.Visible}" CheckEnumKey="TileState">
        <local:MappingConverterEntry Key="{x:Static local:TileState.Enabled}" Value="{x:Static Visibility.Visible}"/>
        <local:MappingConverterEntry Key="{x:Static local:TileState.EnabledNonInteractive}" Value="{x:Static Visibility.Visible}"/>
        <local:MappingConverterEntry Key="{x:Static local:TileState.Disabled}" Value="{x:Static Visibility.Collapsed}"/>
    </local:MappingConverter>

    <local:MappingConverter x:Key="A_Converter_TileStateToBoolean"
        Default="True" CheckEnumKey="TileState">
        <local:MappingConverterEntry Key="{x:Static local:TileState.Enabled}" Value="True"/>
        <local:MappingConverterEntry Key="{x:Static local:TileState.EnabledNonInteractive}" Value="False"/>
        <local:MappingConverterEntry Key="{x:Static local:TileState.Disabled}" Value="False"/>
    </local:MappingConverter>

    <local:MappingConverter x:Key="A_Converter_BooleanToTileState"
        Default="{x:Static local:TileState.Disabled}">
        <local:MappingConverterEntry Key="True" Value="{x:Static local:TileState.Enabled}"/>
        <local:MappingConverterEntry Key="False" Value="{x:Static local:TileState.Disabled}"/>
    </local:MappingConverter>

    <local:MappingConverter x:Key="A_Converter_BooleanToTileState_EnabledNonInteractive"
        Default="{x:Static local:TileState.EnabledNonInteractive}">
        <local:MappingConverterEntry Key="True" Value="{x:Static local:TileState.Enabled}"/>
        <local:MappingConverterEntry Key="False" Value="{x:Static local:TileState.EnabledNonInteractive}"/>
    </local:MappingConverter>

    <local:MappingConverter x:Key="A_Converter_BooleanToTileState_Inverse"
        Default="{x:Static local:TileState.Disabled}">
        <local:MappingConverterEntry Key="True" Value="{x:Static local:TileState.Disabled}"/>
        <local:MappingConverterEntry Key="False" Value="{x:Static local:TileState.Enabled}"/>
    </local:MappingConverter>


    <local:MappingConverter x:Key="A_Converter_TileStateToCommandEnabled" Default="{StaticResource A_Boolean_True}">
        <MappingConverterEntry Key="{x:Static local:TileState.Disabled}" Value="{StaticResource A_Boolean_False}"/>
    </local:MappingConverter>

    <local:MappingConverter x:Key="A_Converter_DeniedCommandToLockState" Default="{x:Static local:LockState.Locked}">
        <local:MappingConverterEntry Key="{x:Null}" Value="{x:Static local:LockState.Unlocked}"/>
    </local:MappingConverter>
    
    <!-- Tile Styles -->
    <Style x:Key="A_Style_Button_RootTile" TargetType="{x:Type local:FZButton}" BasedOn="{StaticResource A_Style_FrameworkElement_DefaultTransition}">
        <Setter Property="Width"
                Value="{Binding Path=(local:TileMenuNavigationManager.GridWidth) ,RelativeSource={RelativeSource Self}, Converter={StaticResource A_LinearTransformConverter_SunriseTileSizeTransform}}" />
        <Setter Property="Height"
                Value="{Binding Path=(local:TileMenuNavigationManager.GridHeight) ,RelativeSource={RelativeSource Self}, Converter={StaticResource A_LinearTransformConverter_SunriseTileSizeTransform}}" />
        <Setter Property="Canvas.Left"
                Value="{Binding Path=(local:TileMenuNavigationManager.GridX) ,RelativeSource={RelativeSource Self}, Converter={StaticResource A_LinearTransformConverter_SunriseTilePositionTransform}}" />
        <Setter Property="Canvas.Top"
                Value="{Binding Path=(local:TileMenuNavigationManager.GridY) ,RelativeSource={RelativeSource Self}, Converter={StaticResource A_LinearTransformConverter_SunriseTilePositionTransform}}" />
        <Setter Property="local:TileMenuNavigationManager.AutoTransitionIndex"
                Value="{x:Static local:TiledMenuAutoTransitionIndex.SetAutoIfInvalid}" />
        <Setter Property="local:TileMenuNavigationManager.TextColorScheme"
                Value="{x:Static local:TextColorScheme.Dark}"/>
        <Setter Property="Panel.ZIndex"
                Value="{Binding (local:UIPageTransitionManager.TransitionIndex), RelativeSource={RelativeSource Self}, Converter={StaticResource A_TransitionIndexToZIndexConverter}}"/>
        <Setter Property="local:ZPanel.ZOffset" Value="0"/>
        <Setter Property="local:BindingProxy.C" Value="DisableMotionBlur"/>
        <Setter Property="RenderTransformOrigin"
                Value="0.5,0.5" />
        <Setter Property="UseSelfAsDefaultCommandParameter"
                Value="True"/>
        <Setter Property="local:MultiStringFormatter.Param0"
                Value="{Binding Heading}"/>
        <Setter Property="local:MultiStringFormatter.Param1"
                Value="{Binding Description}"/>
        <Setter Property="local:ManualPassthroughProperty.Input"
                Value="{Binding (local:MultiStringFormatter.Output), RelativeSource={RelativeSource Self}, Converter={StaticResource A_Converter_TrimInlineMarkupAndNewlines}}"/>
        <Setter Property="local:ManualPassthroughProperty.Allowed"
                Value="{Binding IsKeyboardFocused, RelativeSource={RelativeSource Self}}"/>
        <Setter Property="local:ScreenReader.Line"
                Value="{Binding (local:ManualPassthroughProperty.Output), RelativeSource={RelativeSource Self}}" />
        <Setter Property="local:ScreenReader.Event"
                Value="OnChange" />
        <Setter Property="local:ScreenReader.ControlType"
                Value="Button" />
        <Setter Property="local:ScreenReader.LineType"
                Value="SelectedItem" />
        <Setter Property="local:AccumulateSelfOnParent.ParentType"
                Value="{x:Type Canvas}" />
        <Setter Property="local:FindSelfIndexInCollection.Collection"
                Value="{Binding (local:AccumulateSelfOnParent.Output), RelativeSource={RelativeSource AncestorType={x:Type Canvas}}}" />
        <Setter Property="local:ScreenReader.SelectedNumber"
                Value="{Binding (local:FindSelfIndexInCollection.Index), RelativeSource={RelativeSource Self}, Converter={StaticResource A_IndexToNumberConverter}, FallbackValue=0}" />
        <Setter Property="local:ScreenReader.SelectedCount"
                Value="{Binding (local:AccumulateSelfOnParent.Output).Count, RelativeSource={RelativeSource AncestorType={x:Type Canvas}}, FallbackValue=0}" />
        <Setter Property="Visibility"
                Value="{Binding (local:TileMenuNavigationManager.TileState), RelativeSource={RelativeSource Self}, Converter={StaticResource A_Converter_TileStateToVisibility}, FallbackValue={x:Static Visibility.Visible}}"/>
        <Setter Property="IsEnabled"
                Value="{Binding (local:TileMenuNavigationManager.TileState), RelativeSource={RelativeSource Self}, Converter={StaticResource A_Converter_TileStateToBoolean}, FallbackValue=True}"/>
        <Setter Property="local:PropertySetter.Property" 
                Value="Command.Enabled"/>
        <Setter Property="local:PropertySetter.Value" 
                Value="{Binding Path=(local:TileMenuNavigationManager.TileState), RelativeSource={RelativeSource Self}, Converter={StaticResource A_Converter_TileStateToCommandEnabled}}"/>
        <Setter Property="local:TileMenuNavigationManager.LockState" Value="{Binding Command.DeniedCommand, RelativeSource={RelativeSource Self}, Converter={StaticResource A_Converter_DeniedCommandToLockState}}" />
        <Setter Property="ClickMode"
                Value="{x:Static ClickMode.Press}"/>
    	<Setter Property="local:UIPageTransitionManager.TransitionIndex" Value="0" />
        <Setter Property="CompareValue.A"
                Value="{Binding (TileMenuNavigationManager.EnabledMenuIndex), RelativeSource={RelativeSource Self}, FallbackValue=0}" />
        <Setter Property="CompareValue.B"
                Value="{Binding (AttachedTileMenu.TileMenuNavigationManager).SelectedMenu.(TileMenuNavigationManager.EnabledMenuIndex), RelativeSource={RelativeSource AncestorType=Page}, FallbackValue=0}" />
        <Setter Property="TileMenuNavigationManager.IsOnActiveMenu"
                Value="{Binding (CompareValue.Result), RelativeSource={RelativeSource Self}, Converter={StaticResource H_TrueIfEqual}}" />
        <Setter Property="RenderTransform">
            <Setter.Value>
                <TransformGroup>
                    <ScaleTransform/>
                    <SkewTransform/>
                    <RotateTransform/>
                    <TranslateTransform/>
                </TransformGroup>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="local:TileMenuNavigationManager.IsOnActiveMenu" Value="False">
                <Setter Property="local:PropertySetter.Value"
                        Value="{StaticResource A_Boolean_False}"/>
            </Trigger>
            <!-- This forces the PropertySetter to update when the command changes -->
            <Trigger Property="Command" Value="{x:Null}">
                <Setter Property="local:PropertySetter.Property"
                        Value=""/>
            </Trigger>
            <Trigger Property="local:TileMenuNavigationManager.TileState" Value="{x:Static local:TileState.Enabled}">
                <Setter Property="local:AccumulateSelfOnParent.SortOrder"
                        Value="{Binding (local:TileMenuNavigationManager.SortIndex), RelativeSource={RelativeSource Self}}"/>
            </Trigger>
            <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=IsKeyboardFocused}" Value="True">
                <Setter Property="Panel.ZIndex" Value="3"/>
            </DataTrigger>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="IsMouseOver"
                               Value="True"/>
                    <Condition Property="local:TileMenuNavigationManager.TileState"
                               Value="{x:Static local:TileState.Enabled}"/>
                </MultiTrigger.Conditions>
                <MultiTrigger.EnterActions>
                    <local:CommandAction CommandPropertyPath="(local:AttachedTileMenu.TileMenuNavigationManager).HighlightTile" AncestorType="Page" />
                </MultiTrigger.EnterActions>
            </MultiTrigger>
            <DataTrigger Binding="{Binding Description, Converter={StaticResource A_StringVisConverter}}" Value="{x:Static Visibility.Visible}">
                <Setter Property="local:MultiStringFormatter.Format" Value="{local:Loc Main.IDS_ScreenReader_Format_Tile_DescriptionOnly}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding Heading, Converter={StaticResource A_StringVisConverter}}" Value="{x:Static Visibility.Visible}">
                <Setter Property="local:MultiStringFormatter.Format" Value="{local:Loc Main.IDS_ScreenReader_Format_Tile_HeadingOnly}"/>
            </DataTrigger>
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding Heading, Converter={StaticResource A_StringVisConverter}}" Value="{x:Static Visibility.Visible}"/>
                    <Condition Binding="{Binding Description, Converter={StaticResource A_StringVisConverter}}" Value="{x:Static Visibility.Visible}"/>
                </MultiDataTrigger.Conditions>
                <Setter Property="local:MultiStringFormatter.Format" Value="{local:Loc Main.IDS_ScreenReader_Format_Tile_HeadingAndDescription}"/>
            </MultiDataTrigger>
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding Heading, Converter={StaticResource A_StringVisConverter}}" Value="{x:Static Visibility.Visible}"/>
                    <Condition Binding="{Binding Description, Converter={StaticResource A_StringVisConverter}}" Value="{x:Static Visibility.Visible}"/>
                    <Condition Binding="{Binding (local:TileMenuNavigationManager.LockState), RelativeSource={RelativeSource Self}}" Value="{x:Static LockState.Locked}"/>
                </MultiDataTrigger.Conditions>
                <Setter Property="local:MultiStringFormatter.Format" Value="{local:Loc Main.IDS_ScreenReader_Format_TileLocked_HeadingAndDescription}"/>
            </MultiDataTrigger>            
        </Style.Triggers>
    </Style>

    <Style x:Key="A_Style_FZMaterial_TileBackground_Base"
           TargetType="local:FZMaterial" BasedOn="{StaticResource A_Style_FZMaterial_FlatPanel_Tile}">
        <Setter Property="Opacity"
                Value="1.0" />
        <Setter Property="HorizontalAlignment"
                Value="Stretch" />
        <Setter Property="VerticalAlignment"
                Value="Stretch" />
        <Setter Property="StretchDirection"
                Value="Both" />
    </Style>

    <Style x:Key="A_Style_FZMaterial_TileBackground"
           TargetType="local:FZMaterial" BasedOn="{StaticResource A_Style_FZMaterial_TileBackground_Base}">
        <Style.Triggers>
            <DataTrigger Binding="{Binding UseAlternateColors}"
                         Value="True">
                <Setter Property="Color"
                        Value="{StaticResource A_Color_Tile_Background_Alternate}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding (local:TileMenuNavigationManager.TileState), RelativeSource={RelativeSource FindAncestor, AncestorType=Button}}"
                        Value="{x:Static local:TileState.EnabledNonInteractive}">
                <Setter Property="Preset"
                        Value="{StaticResource A_FZMaterialPresetGlassRoundtangle_GlassPanel_OuterAll}" />
                <Setter Property="Color"
                        Value="{StaticResource A_Color_GlassPanel_TileMenu_NonInteractive}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding (local:TileMenuNavigationManager.LockState), RelativeSource={RelativeSource FindAncestor, AncestorType=Button}}"
                         Value="{x:Static local:LockState.Locked}">
                <Setter Property="Preset"
                        Value="{StaticResource A_FZMaterialPresetGlassRoundtangle_GlassPanel_OuterAll}" />
                <Setter Property="Color"
                        Value="{StaticResource A_Color_GlassPanel_Interactive}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="A_Style_FZMaterial_TileBackground_NoAlternate"
           TargetType="local:FZMaterial" BasedOn="{StaticResource A_Style_FZMaterial_TileBackground_Base}">
    </Style>

    <Style x:Key="A_Style_FZMaterial_TileBackground_NoCornersTinted"
        TargetType="{x:Type local:FZMaterial}"
        BasedOn="{StaticResource A_Style_FZMaterial_TileBackground}">
        <Setter Property="Color" Value="#FFEBEBEB"/>
        <Setter Property="Preset" Value="{StaticResource A_FZMaterialPreset_FlatPanel_Base}"/>
    </Style>

    <local:FZMaterialPresetRoundtangle x:Key="A_FZMaterialPresetRoundtangle_FlatPanel_Desaturated"
        BasedOn="{StaticResource A_FZMaterialPreset_FlatPanel_Base}"
        Saturation="0"/>

    <local:FZMaterialPresetRoundtangle x:Key="A_FZMaterialPresetRoundtangle_FlatPanel_OuterAllDesaturated"
        BasedOn="{StaticResource A_FZMaterialPresetRoundtangle_FlatPanel_OuterAll}"
        Saturation="0"/>

    <local:FZMaterialPresetRoundtangle x:Key="A_FZMaterialPresetRoundtangle_FlatPanel_OuterTopOnlyDesaturated"
        BasedOn="{StaticResource A_FZMaterialPresetRoundtangle_FlatPanel_OuterTopOnly}"
        Saturation="0"/>


    <Style x:Key="A_Style_FZMaterial_LockableImageTileBackground_Base"
           TargetType="local:FZMaterial"
           BasedOn="{StaticResource A_Style_FZMaterial_TileBackground_Base}">
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="VerticalAlignment" Value="Stretch"/>
        <Setter Property="Preset" Value="{StaticResource A_FZMaterialPresetRoundtangle_FlatPanel_OuterTopOnly}"/>
        <Setter Property="local:ManualPassthroughProperty.Input" Value="{Binding DataContext.Icon, RelativeSource={RelativeSource AncestorType=local:FZButton}}" />
        <Setter Property="local:ManualPassthroughProperty.Allowed" Value="{Binding IsInitialized, RelativeSource={RelativeSource AncestorType=Page}, FallbackValue={StaticResource A_Boolean_True}}"/>
        <Setter Property="ImageSource" Value="{Binding (local:ManualPassthroughProperty.Output), RelativeSource={RelativeSource Self}}"/>
        <Setter Property="Visibility" Value="{Binding ImageSource, RelativeSource={RelativeSource Self}, Converter={StaticResource A_FZBooleanToVisibilityConverter}}"/>
    </Style>

    <Style x:Key="A_Style_FZMaterial_LockableImageTileBackground"
           TargetType="local:FZMaterial"
           BasedOn="{StaticResource A_Style_FZMaterial_LockableImageTileBackground_Base}">
        <Style.Triggers>
            <DataTrigger Binding="{Binding UseAlternateColors}" Value="True">
                <Setter Property="Preset" Value="{StaticResource A_FZMaterialPresetRoundtangle_FlatPanel_OuterAll}"/>
            </DataTrigger>
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding (local:TileMenuNavigationManager.LockState), RelativeSource={RelativeSource FindAncestor, AncestorType=Button}}" Value="{x:Static local:LockState.Locked}"/>
                    <Condition Binding="{Binding DataContext.LockedIcon, RelativeSource={RelativeSource AncestorType=Button}, Converter={StaticResource A_FZBooleanToVisibilityConverter}}" Value="{x:Static Visibility.Visible}"/>
                </MultiDataTrigger.Conditions>
                <Setter Property="local:ManualPassthroughProperty.Input" Value="{Binding DataContext.LockedIcon, RelativeSource={RelativeSource TemplatedParent}}"/>
            </MultiDataTrigger>
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding (local:TileMenuNavigationManager.LockState), RelativeSource={RelativeSource AncestorType=Button}}" Value="{x:Static local:LockState.Locked}"/>
                    <Condition Binding="{Binding UseAlternateColors, RelativeSource={RelativeSource AncestorType=Button}}" Value="False"/>
                    <Condition Binding="{Binding DataContext.LockedIcon, RelativeSource={RelativeSource AncestorType=Button}, Converter={StaticResource A_FZBooleanToVisibilityConverter}}" Value="{x:Static Visibility.Collapsed}"/>
                </MultiDataTrigger.Conditions>
                <Setter Property="Preset" Value="{StaticResource A_FZMaterialPresetRoundtangle_FlatPanel_OuterTopOnlyDesaturated}"/>
            </MultiDataTrigger>
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding (local:TileMenuNavigationManager.LockState), RelativeSource={RelativeSource AncestorType=Button}}" Value="{x:Static local:LockState.Locked}"/>
                    <Condition Binding="{Binding UseAlternateColors, RelativeSource={RelativeSource AncestorType=Button}}" Value="True"/>
                    <Condition Binding="{Binding DataContext.LockedIcon, RelativeSource={RelativeSource AncestorType=Button}, Converter={StaticResource A_FZBooleanToVisibilityConverter}}" Value="{x:Static Visibility.Collapsed}"/>
                </MultiDataTrigger.Conditions>
                <Setter Property="Preset" Value="{StaticResource A_FZMaterialPresetRoundtangle_FlatPanel_OuterAllDesaturated}"/>
            </MultiDataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="A_Style_FZMaterial_LockableImageTileBackground_NoCorners"
           TargetType="local:FZMaterial"
           BasedOn="{StaticResource A_Style_FZMaterial_LockableImageTileBackground_Base}">
        <Setter Property="Preset" Value="{StaticResource A_FZMaterialPreset_FlatPanel_Base}"/>
        <Style.Triggers>
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding (local:TileMenuNavigationManager.LockState), RelativeSource={RelativeSource FindAncestor, AncestorType=Button}}" Value="{x:Static local:LockState.Locked}"/>
                    <Condition Binding="{Binding DataContext.LockedIcon, RelativeSource={RelativeSource AncestorType=Button}, Converter={StaticResource A_FZBooleanToVisibilityConverter}}" Value="{x:Static Visibility.Visible}"/>
                </MultiDataTrigger.Conditions>
                <Setter Property="local:ManualPassthroughProperty.Input" Value="{Binding DataContext.LockedIcon, RelativeSource={RelativeSource AncestorType=Button}}"/>
            </MultiDataTrigger>
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding (local:TileMenuNavigationManager.LockState), RelativeSource={RelativeSource AncestorType=Button}}" Value="{x:Static local:LockState.Locked}"/>
                    <Condition Binding="{Binding DataContext.LockedIcon, RelativeSource={RelativeSource AncestorType=Button}, Converter={StaticResource A_FZBooleanToVisibilityConverter}}" Value="{x:Static Visibility.Collapsed}"/>
                </MultiDataTrigger.Conditions>
                <Setter Property="Preset" Value="{StaticResource A_FZMaterialPresetRoundtangle_FlatPanel_Desaturated}"/>
            </MultiDataTrigger>
        </Style.Triggers>
    </Style>



    <Style x:Key="A_Style_ContentControl_NotificationBadge_Tile"
           TargetType="{x:Type ContentControl}">
        <Style.Resources>
            <ImageSource x:Key="A_ImageSource_NotificationBadge_Tile_Background_Dynamic">/ForzaUI;component/Textures/Anthem/Icons/TiledMenus/NotificationBadges/Badge_IconTile.png</ImageSource>
            <ImageSource x:Key="A_ImageSource_NotificationBadge_Tile_Background_Alternate_Dynamic">/ForzaUI;component/Textures/Anthem/Icons/TiledMenus/NotificationBadges/Badge_IconTile_Alternate.png</ImageSource>
            <System:Double x:Key="A_Double_NotificationBadge_Tile_BackgroundHeight_Dynamic">43</System:Double>
            <Color x:Key="A_Color_NotificationBadge_Text_Alternate_Dynamic">#FF00B592</Color>
            <local:UIStoryboard x:Key="A_Storyboard_NotificationBadge_Hide_Instant">
                <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="(UIElement.Opacity)"
                    Storyboard.TargetName="{x:Null}">
                    <EasingDoubleKeyFrame KeyTime="0:0:0.0" Value="0"/>
                </DoubleAnimationUsingKeyFrames>
            </local:UIStoryboard>
            <local:UIStoryboard x:Key="A_Storyboard_NotificationBadge_Show" DurationOverride="0:0:0.4">
                <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="(UIElement.Opacity)"
                    Storyboard.TargetName="{x:Null}">
                    <EasingDoubleKeyFrame KeyTime="0:0:0.0" Value="1"/>
                </DoubleAnimationUsingKeyFrames>
                <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                    Storyboard.TargetName="{x:Null}"
                    BeginTime="0:0:0.3">
                    <EasingDoubleKeyFrame KeyTime="0:0:0.0" Value="0"/>
                    <EasingDoubleKeyFrame KeyTime="0:0:0.65" Value="1.125" EasingFunction="{local:QuadraticEasing EasingMode=EaseOut}"/>
                    <EasingDoubleKeyFrame KeyTime="0:0:1.0" Value="1" EasingFunction="{local:QuadraticEasing EasingMode=EaseIn}"/>
                </DoubleAnimationUsingKeyFrames>
                <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                    Storyboard.TargetName="{x:Null}"
                    BeginTime="0:0:0.3">
                    <EasingDoubleKeyFrame KeyTime="0:0:0.0" Value="0"/>
                    <EasingDoubleKeyFrame KeyTime="0:0:0.65" Value="1.125" EasingFunction="{local:QuadraticEasing EasingMode=EaseOut}"/>
                    <EasingDoubleKeyFrame KeyTime="0:0:1.0" Value="1" EasingFunction="{local:QuadraticEasing EasingMode=EaseIn}"/>
                </DoubleAnimationUsingKeyFrames>
            </local:UIStoryboard>
        </Style.Resources>
        <Setter Property="HorizontalAlignment"
                Value="Right" />
        <Setter Property="VerticalAlignment"
                Value="Bottom" />
        <Setter Property="Panel.ZIndex"
                Value="1" />
        <Setter Property="Focusable"
                Value="False" />
        <Setter Property="RenderTransform">
            <Setter.Value>
                <ScaleTransform/>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate>
                    <local:FZMaterial x:Name="NotificationBadgeBackground"
                                      HorizontalAlignment="Left"
                                      VerticalAlignment="Top"
                                      Width="43"
                                      Height="{DynamicResource A_Double_NotificationBadge_Tile_BackgroundHeight_Dynamic}"
                                      ImageSource="{DynamicResource A_ImageSource_NotificationBadge_Tile_Background_Dynamic}"
                                      Margin="0,0,-6,-9"
                                      Visibility="{Binding Content, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource A_StringVisConverter}}">
                        <Decorator Margin="4,1,0,0"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top"
                            Width="26"
                            Height="26">
                            <local:FZTextBlock x:Name="NotificationBadgeText"
                                           Text="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}"
                                           Style="{StaticResource A_Style_FZTextBlock_HorizonA}"
                                           Color="{StaticResource A_Color_NotificationBadge_Text}"
                                           FontSize="19"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Margin="2,0" />
                        </Decorator>
                    </local:FZMaterial>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding UseAlternateColors}" Value="True">
                            <Setter Property="ImageSource" TargetName="NotificationBadgeBackground" Value="{DynamicResource A_ImageSource_NotificationBadge_Tile_Background_Alternate_Dynamic}"/>
                            <Setter Property="Color" TargetName="NotificationBadgeText" Value="{DynamicResource A_Color_NotificationBadge_Text_Alternate_Dynamic}"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Path=(local:UIPageTransitionManager.TransitionManager).(TransitionState), RelativeSource={RelativeSource AncestorType=Page}, FallbackValue={x:Static local:UIPageTransitionState.Idle}}"
                            Value="{x:Static local:UIPageTransitionState.TransitioningInForward}">
                            <DataTrigger.EnterActions>
                                <BeginStoryboard Storyboard="{StaticResource A_Storyboard_NotificationBadge_Hide_Instant}"/>
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <BeginStoryboard Storyboard="{StaticResource A_Storyboard_NotificationBadge_Show}"/>
                            </DataTrigger.ExitActions>
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

