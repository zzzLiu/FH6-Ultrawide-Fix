    <Style x:Key="A_Style_FZMaterial_TileShadow" TargetType="{x:Type local:FZMaterial}" BasedOn="{StaticResource A_Style_FZMaterial_ShadowBase}">
        <Setter Property="IsHitTestVisible" Value="False"/>
        <Setter Property="Preset">
            <Setter.Value>
