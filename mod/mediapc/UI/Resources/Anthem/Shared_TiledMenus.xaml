    <ControlTemplate x:Key="A_ControlTemplate_TileTitlePanel"
        TargetType="{x:Type ContentControl}">
        <Grid ClipToBounds="True" Height="{StaticResource A_Double_Size_Tile_TitlePanel}">
            <local:FZMaterial x:Name="TintedPanel"
                Color="{StaticResource A_Color_Tile_TintedPanel}"
                Visibility="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource A_FZBooleanToVisibilityConverter}}"
                Height="{StaticResource A_Double_Size_Tile_TitlePanel}"
                VerticalAlignment="Bottom"/>
            <ContentPresenter x:Name="PanelContent"
                Margin="{StaticResource A_Thickness_TilePadding}">
                <ContentPresenter.RenderTransform>
                    <TranslateTransform Y="0"/>
                </ContentPresenter.RenderTransform>
            </ContentPresenter>
        </Grid>
        <ControlTemplate.Resources>
            <local:UIStoryboard x:Key="A_Storyboard_TileTitlePanel_Hide_Instant">
                <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="(FrameworkElement.Height)" Storyboard.TargetName="TintedPanel">
                    <EasingDoubleKeyFrame KeyTime="0:0:0.0" Value="0"/>
                </DoubleAnimationUsingKeyFrames>
                <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" Storyboard.TargetName="PanelContent">
                    <EasingDoubleKeyFrame KeyTime="0:0:0.0" Value="{StaticResource A_Double_Size_Tile_TitlePanel}"/>
                </DoubleAnimationUsingKeyFrames>
            </local:UIStoryboard>
            <local:UIStoryboard x:Key="A_Storyboard_TileTitlePanel_Show" DurationOverride="0:0:0.333">
                <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="(FrameworkElement.Height)" Storyboard.TargetName="TintedPanel"
                    FillBehavior="Stop">
                    <EasingDoubleKeyFrame KeyTime="0:0:0.0" Value="0"/>
                    <EasingDoubleKeyFrame KeyTime="0:0:1.0"
                        Value="{StaticResource A_Double_Size_Tile_TitlePanel}"
                        EasingFunction="{local:QuarticEasing EasingMode=EaseOut}"/>
                </DoubleAnimationUsingKeyFrames>
                <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" Storyboard.TargetName="PanelContent"
                    FillBehavior="Stop">
                    <EasingDoubleKeyFrame KeyTime="0:0:0.0" Value="{StaticResource A_Double_Size_Tile_TitlePanel}"/>
                    <EasingDoubleKeyFrame KeyTime="0:0:1.0"
                        Value="0"
                        EasingFunction="{local:QuarticEasing EasingMode=EaseOut}"/>
                </DoubleAnimationUsingKeyFrames>
            </local:UIStoryboard>
        </ControlTemplate.Resources>
        <ControlTemplate.Triggers>
            <Trigger Property="local:BindingProxy.A">
                <Trigger.Value>
                    <System:Boolean>True</System:Boolean>
                </Trigger.Value>
                <Setter Property="Preset"
                    TargetName="TintedPanel"
                    Value="{StaticResource A_FZMaterialPresetRoundtangle_TintPanel_OuterBottomOnly}"/>
            </Trigger>
            <DataTrigger Binding="{Binding Path=(local:UIPageTransitionManager.TransitionManager).(TransitionState), RelativeSource={RelativeSource AncestorType=Page}, FallbackValue={x:Static local:UIPageTransitionState.Idle}}"
                Value="{x:Static local:UIPageTransitionState.TransitioningInForward}">
                <DataTrigger.EnterActions>
                    <BeginStoryboard Storyboard="{StaticResource A_Storyboard_TileTitlePanel_Hide_Instant}"/>
                </DataTrigger.EnterActions>
                <DataTrigger.ExitActions>
                    <BeginStoryboard Storyboard="{StaticResource A_Storyboard_TileTitlePanel_Show}"/>
                </DataTrigger.ExitActions>
            </DataTrigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

